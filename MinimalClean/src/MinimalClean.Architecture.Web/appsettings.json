{
  "ConnectionStrings": {
    "AppDb": "Server=(localdb)\\mssqllocaldb;Database=MinimalCleanArchitecture;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "Mailserver": {
    // Requires STARTTLS by default (SecureSocketOptions: StartTls). Set Username here and
    // Mailserver:Password in user secrets or your host's secret store to authenticate.
    "Hostname": "localhost",
    "Port": 25
  },
  "DatabaseOptions": {
    // Set to true to apply migrations and seed data on startup (useful for containerized environments).
    // Migrations always run in the Development environment.
    "ApplyMigrationsOnStartup": false
  }
}
